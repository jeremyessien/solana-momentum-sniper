{
  "name": "moonscout",
  "version": "0.0.0",
  "private": true,
  "description": "Personal Solana memecoin trading bot — selectivity over speed",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-migrations.ts",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:helius": "tsx --env-file=.env scripts/check-helius-stream.ts",
    "inspect:pumpfun": "tsx --env-file=.env scripts/inspect-pumpfun-create.ts",
    "verify:pumpfun-fixture": "tsx scripts/verify-pumpfun-create-fixture.ts",
    "capture:pumpfun-fixtures": "tsx --env-file=.env scripts/capture-pumpfun-fixtures.ts",
    "capture:pumpfun-trade-fixtures": "tsx --env-file=.env scripts/capture-pumpfun-trade-fixtures.ts",
    "investigate:rugcheck-fresh": "tsx --env-file=.env scripts/investigate-rugcheck-fresh-token.ts",
    "investigate:pumpfun-race": "tsx --env-file=.env scripts/investigate-pumpfun-create-trade-race.ts",
    "investigate:pumpportal": "tsx scripts/investigate-pumpportal-newtoken.ts",
    "verify:pumpportal-creator": "tsx --env-file=.env scripts/verify-pumpportal-creator.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^25.6.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@solana/kit": "^6.9.0",
    "better-sqlite3": "12.9.0",
    "grammy": "^1.42.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
