# moonscout configuration
# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Path to the SQLite database file (created on first run)
DATABASE_PATH=./data/moonscout.db

# Helius API key — sign up at https://helius.dev
HELIUS_API_KEY=

# Telegram bot token — from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to send commands.
# Find your user ID by messaging @userinfobot.
TELEGRAM_USER_ID_WHITELIST=